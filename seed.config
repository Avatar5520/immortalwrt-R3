CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r3=y

# 預裝 LuCI 網頁介面及繁體中文語言包
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-tw=y

# 預裝 SFP 調試及網絡必備工具
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_i2c-tools=y

# 預裝 Realtek USB 2.5G 網卡驅動
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y

# 預裝 MultiWAN Manager (mwan3 多線負載均衡及繁體中文介面)
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-tw=y
