CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r3=y

# LuCI Web UI (English Default)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# SFP Debug & Network Tools
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_i2c-tools=y
CONFIG_PACKAGE_kmod-sfp=y
CONFIG_PACKAGE_kmod-phylink=y
CONFIG_PACKAGE_kmod-i2c-gpio=y
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y

# Realtek PCIe 2.5G (RTL8125 / RTL8125BG - PCI_ID 10EC:8125)
CONFIG_PACKAGE_kmod-r8169=y

# Virtual Interface, NAT & Traffic Control (from official build)
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-sched-flower=y
CONFIG_PACKAGE_kmod-sched-act-vlan=y

# USB Storage & Filesystems (exFAT / NTFS / ext4 / VFAT)
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# MultiWAN Manager (mwan3)
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
